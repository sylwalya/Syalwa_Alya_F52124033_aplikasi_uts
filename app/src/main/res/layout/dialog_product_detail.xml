<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar for Bottom Sheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_category_chip_unselected" />

    <!-- Product Image Hero Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_badge"
        android:padding="20dp">

        <ImageView
            android:id="@+id/dialogImgProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_product_img"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_perfume" />

        <TextView
            android:id="@+id/dialogTvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_badge"
            android:textColor="@color/chanel_gold_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="PARFUM" />
    </FrameLayout>

    <!-- Title & Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogTvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/chanel_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="N°5 Eau de Parfum" />

            <TextView
                android:id="@+id/dialogTvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/chanel_text_secondary"
                android:textSize="13sp"
                tools:text="100 ml • Iconic Floral Aldehyde" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialogTvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/chanel_black"
            android:textSize="18sp"
            tools:text="Rp 2.850.000" />
    </LinearLayout>

    <!-- Rating Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/cd_rating_star"
            android:src="@drawable/ic_star" />

        <TextView
            android:id="@+id/dialogTvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/chanel_text_primary"
            android:textSize="13sp"
            tools:text="4.9 / 5.0" />

        <TextView
            android:id="@+id/dialogTvReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/chanel_text_secondary"
            android:textSize="12sp"
            tools:text="(1,280 ulasan pembeli)" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/chanel_gray_border" />

    <!-- Description Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/heading_description"
        android:textColor="@color/chanel_black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogTvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/chanel_text_primary"
        android:textSize="13sp"
        tools:text="Wewangian legendaris yang abadi dari CHANEL. Perpaduan sempurna antara aldehida, mawar May, dan melati Grasse yang memberikan keharuman elegan dan mewah sepanjang hari." />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnAddCart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_add_cart"
            android:textColor="@color/chanel_black"
            android:textSize="11sp"
            android:textStyle="bold"
            app:strokeColor="@color/chanel_black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnBuy"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/chanel_black"
            android:text="@string/btn_buy_now"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
